[Unit]
Description=Lifecycle Agent reconfigure result-writer (self-contained USB IBI)
# Ordering only, NOT Requires=/Requisite=: installation-configuration.service is
# RemainAfterExit=no, so a successful post-pivot goes inactive, which a hard
# dependency would misread as a failure. The result-writer observes live cluster
# state across post-pivot restarts rather than depending on its unit state.
After=installation-configuration.service
# Gate on the post-pivot completion marker, not merely the handoff. The handoff is
# written early (right after the clock gate, before recert) to anchor the deadline, so
# its presence alone does not mean reconfiguration finished: if post-pivot fails after
# writing the handoff but before recert completes, this After=-ordered unit could start
# and record a false success against the still-healthy seed cluster. The completion
# marker is written only once reconfiguration actually finishes. Both conditions are
# ANDed: only the self-contained post-pivot writes either file, so this also keeps the
# unit from running at all on IBU/install-only.
ConditionPathExists=/var/lib/lca/reconfigure-handoff.json
ConditionPathExists=/var/lib/lca/reconfigure-completed

[Service]
Type=oneshot
RemainAfterExit=yes
# The writer may poll up to the full convergence timeout; disable systemd's start
# timeout so it is never killed before its own deadline.
TimeoutStartSec=0
ExecStart=/usr/local/bin/lca-cli init-monitor --reconfigure-result-writer

[Install]
WantedBy=multi-user.target
