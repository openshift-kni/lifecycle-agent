[Unit]
Description=Lifecycle Agent reconfigure result-writer (self-contained USB IBI)
# Ordering only, NOT Requires=/Requisite=: installation-configuration.service is
# RemainAfterExit=no, so a successful post-pivot goes inactive, which a hard
# dependency would misread as a failure. The result-writer observes live cluster
# state across post-pivot restarts rather than depending on its unit state.
After=installation-configuration.service
# Gate startup on the durable handoff only (written by the self-contained post-pivot), so
# the unit never runs on IBU/install-only. Do NOT also gate startup on the post-pivot
# completion marker: the writer must run to ENFORCE the convergence deadline even when
# post-pivot stalls or fails and never writes that marker -- otherwise the node would hang
# instead of halting at the deadline. The completion marker gates only the SUCCESS verdict,
# enforced in code (successCriterionMet), so the writer still cannot record a false success
# against the still-healthy seed cluster before reconfiguration finishes.
ConditionPathExists=/var/lib/lca/reconfigure-handoff.json

[Service]
Type=oneshot
RemainAfterExit=yes
# The writer may poll up to the full convergence timeout; disable systemd's start
# timeout so it is never killed before its own deadline.
TimeoutStartSec=0
ExecStart=/usr/local/bin/lca-cli init-monitor --reconfigure-result-writer

[Install]
WantedBy=multi-user.target
