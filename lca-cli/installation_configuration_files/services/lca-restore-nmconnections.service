[Unit]
Description=Restore NetworkManager connection profiles for image based SNO configuration
# When NetworkManager finds a NIC without a matching profile it creates
# and auto-activates a default DHCP profile for it, and keeps that
# connection across a restart. The provided profiles therefore have to
# be in place before NetworkManager first starts. This is kept separate
# from installation-configuration.service because that one has to wait
# for coreos-update-ca-trust.service, which finishes too late.
# NetworkManager requires this unit (see [Install]), so a failed restore
# keeps NetworkManager from starting without the profiles. When nothing
# is staged the condition skips the unit and NetworkManager starts normally.
Before=NetworkManager.service
ConditionDirectoryNotEmpty=/var/opt/openshift/network-configuration/system-connections

[Service]
Type=oneshot
# Stay active so later NetworkManager restarts do not run the restore again
RemainAfterExit=yes
TimeoutStartSec=120
ExecStart=/usr/local/bin/lca-cli restore-nmconnections

[Install]
RequiredBy=NetworkManager.service
